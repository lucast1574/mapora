{
  "openapi": "3.1.0",
  "info": {
    "title": "Mapora API",
    "version": "3.0.0",
    "description": "API geográfica de Mapora. Requiere API key. Cada petición geográfica autenticada admitida consume una unidad, también si responde desde caché o devuelve un error. Free: 1.000/mes; Launch: 25.000/mes; Scale: sin cuota mensual. Se aplican límites por minuto. Búsqueda y consulta inversa con Photon/OpenStreetMap. Autocompletado, búsqueda estructurada mundial, lugares cercanos, lotes (10 direcciones), cobertura GeoJSON y rutas/matrices (Latinoamérica inicialmente, ampliación mundial pendiente). Cada llamada HTTP admitida consume una petición; no hay tráfico en tiempo real.",
    "license": {
      "name": "Private application; geographic data © OpenStreetMap contributors (ODbL)",
      "url": "https://www.openstreetmap.org/copyright"
    }
  },
  "servers": [
    {
      "url": "https://maps-api.nexode.app"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    },
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Local process health (does not test providers)",
        "responses": {
          "200": {
            "description": "Healthy"
          },
          "401": {
            "description": "Missing, invalid or revoked API key"
          },
          "403": {
            "description": "Account suspended or missing scope"
          },
          "429": {
            "description": "Monthly quota or per-minute rate exceeded; see Retry-After"
          }
        },
        "security": [],
        "description": ""
      }
    },
    "/v1/search": {
      "get": {
        "summary": "Search addresses, streets, districts and places",
        "description": "Global OSM search with autocomplete, optional country filters, bounding box and location bias. Names use the local OSM language by default. Requires an API key.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Text, 2 to 200 characters",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum results, 1 to 20 (default 8)",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "countrycodes",
            "in": "query",
            "required": false,
            "description": "Comma-separated country codes: pe,co,ec",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lat",
            "in": "query",
            "required": false,
            "description": "Latitude of preferred search area",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "lng",
            "in": "query",
            "required": false,
            "description": "Longitude of preferred search area; lon is also accepted",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "bbox",
            "in": "query",
            "required": false,
            "description": "Restrict to minLng,minLat,maxLng,maxLat",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "description": "es/local (local names), en, de or fr",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search candidates",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "query": {
                      "type": "string"
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Location"
                      }
                    },
                    "count": {
                      "type": "integer"
                    },
                    "cached": {
                      "type": "boolean"
                    },
                    "tookMs": {
                      "type": "integer"
                    },
                    "attribution": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "422": {
            "description": "Google Maps link could not be resolved"
          },
          "502": {
            "description": "Geocoding provider unavailable"
          },
          "503": {
            "description": "Service busy"
          },
          "504": {
            "description": "Timeout"
          },
          "401": {
            "description": "Missing, invalid or revoked API key"
          },
          "403": {
            "description": "Account suspended or missing scope"
          },
          "429": {
            "description": "Monthly quota or per-minute rate exceeded; see Retry-After"
          }
        }
      }
    },
    "/v1/reverse": {
      "get": {
        "summary": "Reverse geocode coordinates",
        "description": "Top-level coordinates remain the requested point. matchedLatitude/matchedLongitude identify the nearby OSM feature. The nearest feature may be a POI, not an exact street address.",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "description": "Latitude",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "lng",
            "in": "query",
            "required": true,
            "description": "Longitude; lon is also accepted",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Location"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "422": {
            "description": "Google Maps link could not be resolved"
          },
          "502": {
            "description": "Geocoding provider unavailable"
          },
          "503": {
            "description": "Service busy"
          },
          "504": {
            "description": "Timeout"
          },
          "401": {
            "description": "Missing, invalid or revoked API key"
          },
          "403": {
            "description": "Account suspended or missing scope"
          },
          "429": {
            "description": "Monthly quota or per-minute rate exceeded; see Retry-After"
          }
        }
      }
    },
    "/v1/resolve": {
      "post": {
        "summary": "Resolve a Google Maps link",
        "description": "Keeps the exact Google pin and selected venue name. includeAddress defaults to true. If address lookup fails, coordinates remain available and addressStatus is unavailable. includeAddress=false skips reverse geocoding. cached refers to the link/pin cache. resolved_url retains the expanded URL. This does not call Google Places.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "url"
                ],
                "additionalProperties": false,
                "properties": {
                  "url": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "includeAddress": {
                    "type": "boolean",
                    "default": true
                  }
                }
              },
              "example": {
                "url": "https://www.google.com/maps/place/Plaza+Mayor/@-12.0453,-77.0309,17z",
                "includeAddress": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Location"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "422": {
            "description": "Google Maps link could not be resolved"
          },
          "502": {
            "description": "Geocoding provider unavailable"
          },
          "503": {
            "description": "Service busy"
          },
          "504": {
            "description": "Timeout"
          },
          "401": {
            "description": "Missing, invalid or revoked API key"
          },
          "403": {
            "description": "Account suspended or missing scope"
          },
          "429": {
            "description": "Monthly quota or per-minute rate exceeded; see Retry-After"
          }
        }
      },
      "get": {
        "summary": "Resolve via query parameters",
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "description": "Google Maps HTTPS link",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "includeAddress",
            "in": "query",
            "required": false,
            "description": "Whether to reverse geocode the pin",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Location"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "422": {
            "description": "Google Maps link could not be resolved"
          },
          "502": {
            "description": "Geocoding provider unavailable"
          },
          "503": {
            "description": "Service busy"
          },
          "504": {
            "description": "Timeout"
          },
          "401": {
            "description": "Missing, invalid or revoked API key"
          },
          "403": {
            "description": "Account suspended or missing scope"
          },
          "429": {
            "description": "Monthly quota or per-minute rate exceeded; see Retry-After"
          }
        },
        "description": ""
      }
    },
    "/v1/maps": {
      "post": {
        "summary": "Create an interactive, embeddable map",
        "description": "Requires maps scope. Consumes one admitted API request. Returns an opaque public view capability, never an API key. Opening/panning/zooming the viewer does not consume additional Mapora requests. Links expire (7 days by default, 30 maximum) and become unavailable when the issuing key is revoked or the account disabled. Public OpenStreetMap raster tiles are loaded directly by the browser, with no availability guarantee.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "anyOf": [
                  {
                    "required": [
                      "center"
                    ]
                  },
                  {
                    "required": [
                      "markers"
                    ]
                  }
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "maxLength": 160
                  },
                  "center": {
                    "$ref": "#/components/schemas/MapPoint"
                  },
                  "markers": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 200,
                    "items": {
                      "$ref": "#/components/schemas/MapPoint"
                    }
                  },
                  "zoom": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 19,
                    "default": 14
                  },
                  "expiresIn": {
                    "type": "integer",
                    "minimum": 60,
                    "maximum": 2592000,
                    "default": 604800
                  },
                  "theme": {
                    "enum": [
                      "light",
                      "dark",
                      "grayscale"
                    ]
                  },
                  "accent": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "shapes": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Polygon"
                    },
                    "minItems": 0,
                    "maxItems": 10
                  },
                  "route": {
                    "$ref": "#/components/schemas/LineString"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Map created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "embedHtml": {
                      "type": "string"
                    },
                    "expiresAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "map": {
                      "type": "object"
                    },
                    "usage": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid coordinates, markers, zoom or lifetime"
          },
          "401": {
            "description": "Missing or invalid API key"
          },
          "403": {
            "description": "maps scope required or suspended account"
          },
          "429": {
            "description": "Quota or rate exceeded"
          },
          "503": {
            "description": "Storage or quota unavailable"
          }
        }
      }
    },
    "/v1/maps/view/{token}": {
      "get": {
        "summary": "Read the map described by a view capability",
        "security": [],
        "description": "Public only to holders of the opaque map token. Does not grant geocoding, account access or key access. Does not consume quota. No-store responses preserve revocation and expiry checks.",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Map specification and expiry"
          },
          "404": {
            "description": "Invalid, expired, revoked or suspended map"
          },
          "503": {
            "description": "Storage unavailable"
          }
        }
      }
    },
