          },
          "503": {
            "description": "Unable to check status"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Location": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "placeName": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "streetAddress": {
            "type": "string"
          },
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          },
          "street": {
            "type": "string"
          },
          "houseNumber": {
            "type": "string"
          },
          "district": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "countryCode": {
            "type": "string"
          },
          "postcode": {
            "type": "string"
          },
          "googleMapsLink": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "attribution": {
            "type": "string"
          },
          "resolved_url": {
            "type": "string"
          },
          "addressStatus": {
            "type": "string"
          },
          "matchedPlaceName": {
            "type": "string"
          },
          "matchedLatitude": {
            "type": "number"
          },
          "matchedLongitude": {
            "type": "number"
          },
          "cached": {
            "type": "boolean"
          },
          "tookMs": {
            "type": "number"
          },
          "quality": {
            "$ref": "#/components/schemas/AddressQuality"
          },
          "distanceMeters": {
            "type": "number",
            "description": "Straight-line meters from nearby query center."
          }
        }
      },
      "MapPoint": {
        "type": "object",
        "required": [
          "latitude",
          "longitude"
        ],
        "additionalProperties": false,
        "properties": {
          "latitude": {
            "type": "number",
            "minimum": -85.05112878,
            "maximum": 85.05112878
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "label": {
            "type": "string",
            "maxLength": 160
          }
        }
      },
      "Point": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        },
        "required": [
          "latitude",
          "longitude"
        ]
      },
      "AddressQuality": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "precision": {
            "type": "string",
            "description": "Feature type, street or address; source completeness, not accuracy certification."
          },
          "missingFields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0,
            "maxItems": 4
          },
          "verified": {
            "const": false
          }
        },
        "required": [
          "precision",
          "missingFields",
          "verified"
        ]
      },
      "Polygon": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "Polygon"
          },
          "coordinates": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "minItems": 4,
              "maxItems": 200
            },
            "minItems": 1,
            "maxItems": 5
          }
        },
        "required": [
          "type",
          "coordinates"
        ],
        "description": "GeoJSON [longitude,latitude]. Closed non-crossing rings, max200 total vertices; exterior + up to4 holes; no antimeridian crossing."
      },
      "Zone": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "geometry": {
            "$ref": "#/components/schemas/Polygon"
          },
          "feeCents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          }
        },
        "required": [
          "name",
          "geometry",
          "feeCents",
          "currency"
        ]
      },
      "LineString": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "LineString"
          },
          "coordinates": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "minItems": 2,
            "maxItems": 10000
          }
        },
        "required": [
          "type",
          "coordinates"
        ]
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Mapora API key"
      }
    }
  }
}
