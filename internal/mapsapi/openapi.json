      }
    },
    "/v1/coverage/check": {
      "post": {
        "summary": "Check saved zones owned by this key account",
        "description": "Required scope: coverage. One admitted HTTP request consumes one plan request.",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing or revoked key"
          },
          "403": {
            "description": "Scope/origin/account denied"
          },
          "429": {
            "description": "Quota/rate limit; honor Retry-After"
          },
          "502": {
            "description": "Geographic engine unavailable"
          },
          "503": {
            "description": "Service busy/unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "point": {
                    "$ref": "#/components/schemas/Point"
                  },
                  "zoneIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1,
                    "maxItems": 20
                  }
                },
                "required": [
                  "point",
                  "zoneIds"
                ]
              }
            }
          }
        }
      }
    },
    "/v1/routes": {
      "post": {
        "summary": "Compute street route, GeoJSON and instructions",
        "description": "Required scope: routing. One admitted HTTP request consumes one plan request.",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing or revoked key"
          },
          "403": {
            "description": "Scope/origin/account denied"
          },
          "429": {
            "description": "Quota/rate limit; honor Retry-After"
          },
          "502": {
            "description": "Geographic engine unavailable"
          },
          "503": {
            "description": "Service busy/unavailable"
          },
          "422": {
            "description": "No accessible road/path connection in available routing data; no straight-line substitute."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "locations": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Point"
                    },
                    "minItems": 2,
                    "maxItems": 10
                  },
                  "profile": {
                    "enum": [
                      "driving",
                      "walking",
                      "cycling"
                    ],
                    "default": "driving"
                  }
                },
                "required": [
                  "locations"
                ]
              }
            }
          }
        }
      }
    },
    "/v1/matrix": {
      "post": {
        "summary": "Travel times and distances for up to10x10 pairs",
        "description": "Required scope: routing. One admitted HTTP request consumes one plan request.",
        "responses": {
