    "/v1/geocode": {
      "get": {
        "summary": "Structured address search",
        "description": "Required scope: search. One admitted HTTP request consumes one plan request.",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing or revoked key"
          },
          "403": {
            "description": "Scope/origin/account denied"
          },
          "429": {
            "description": "Quota/rate limit; honor Retry-After"
          },
          "502": {
            "description": "Geographic engine unavailable"
          },
          "503": {
            "description": "Service busy/unavailable"
          }
        },
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum results, 1 to 20 (default 8)",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "countrycodes",
            "in": "query",
            "required": false,
            "description": "Comma-separated country codes: pe,co,ec",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "description": "es/local (local names), en, de or fr",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "street",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "in": "query",
            "name": "housenumber",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "in": "query",
            "name": "city",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "in": "query",
            "name": "district",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "in": "query",
            "name": "county",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "in": "query",
            "name": "postcode",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          }
        ]
      }
    },
    "/v1/nearby": {
      "get": {
        "summary": "Find nearby indexed points of interest",
        "description": "Required scope: nearby. One admitted HTTP request consumes one plan request.",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing or revoked key"
          },
          "403": {
            "description": "Scope/origin/account denied"
          },
          "429": {
            "description": "Quota/rate limit; honor Retry-After"
          },
          "502": {
            "description": "Geographic engine unavailable"
          },
          "503": {
            "description": "Service busy/unavailable"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "lat",
            "required": true,
            "schema": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          },
          {
            "in": "query",
            "name": "lng",
            "required": true,
            "schema": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          {
            "in": "query",
            "name": "category",
            "required": true,
            "schema": {
              "enum": [
                "pharmacy",
                "restaurant",
                "hospital",
                "fuel",
                "supermarket",
                "hotel",
                "bank",
                "parking",
                "cafe"
              ]
            }
          },
          {
            "in": "query",
            "name": "radius",
            "required": false,
            "schema": {
              "type": "number",
              "minimum": 50,
              "maximum": 50000,
              "default": 5000
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 8
            }
          }
        ]
      }
    },
    "/v1/batch": {
      "post": {
        "summary": "Geocode up to10 addresses, ordered per-item outcomes",
        "description": "Required scope: batch. One admitted HTTP request consumes one plan request.",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
